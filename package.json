{
  "name": "minimart-server",
  "version": "1.0.0",
  "description": "",
  "main": "minimart-server.ts",
  "scripts": {
    "update-metadata": "node_modules/.bin/schemats generate -c mysql://root:123@localhost/minimart -t test -s minimart -o db/model_generated.ts",
    "copy:node_modules": "shx cp -r ./node_modules ../dist/server",
    "build": "tsc",
    "start-server": "npm run build && node ./dist/minimart-server.js",
    "start": "node ./dist/minimart-server.js",
    "dev": "nodemon -e ts -w ./ -x npm run start-server",
    "prod-test": "NODE_ENV=production npm run start-server",
    "prod": "NODE_ENV=production node ./dist/minimart-server.js",
    "test": "mocha -r ts-node/register test/**/*.spec.ts --exit"
  },
  "author": "Sunoj Vijayan",
  "license": "ISC",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer-direct-transport": "^1.0.31",
    "bcryptjs": "^3.0.3",
    "dotenv": "^8.6.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^8.5.1",
    "moment": "^2.24.0",
    "multer": "^1.4.2",
    "mysql": "^2.17.1",
    "mysql2": "^2.3.3",
    "nodemailer": "^6.4.18",
    "nodemon": "^3.1.14",
    "schemats": "^3.0.3",
    "uuid": "^3.3.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^8.3.3",
    "@types/mocha": "^5.2.7",
    "@types/multer": "^1.3.10",
    "@types/mysql": "^2.15.6",
    "@types/node": "^13.13.42",
    "@types/nodemailer": "^6.4.0",
    "@types/nodemailer-smtp-transport": "^2.7.4",
    "@types/uuid": "^3.4.5",
    "chai": "^4.2.0",
    "chai-http": "^4.3.0",
    "mocha": "^6.1.4",
    "shx": "^0.4.0",
    "ts-node-register": "^1.0.0",
    "typescript": "^3.5.3"
  }
}
