PORT=3000

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Railway-style aliases are also supported:
# MYSQL_URL=
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

AWS_REGION=
AWS_S3_BUCKET=
